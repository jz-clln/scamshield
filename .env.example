# OpenAI — used for image text extraction and final explanation
OPENAI_API_KEY=

# JEV — the structured risk decision engine.
# If JEV_API_URL is set, /api/analyze calls it directly and expects a JSON
# body matching JevResult (see src/types/analysis.ts).
# If it is left empty, the app falls back to the local heuristic engine in
# src/lib/jev.ts so the app is demoable without a live JEV service.
JEV_API_URL=
JEV_API_KEY=
