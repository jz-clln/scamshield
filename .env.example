# OpenAI — used for image text extraction and final explanation
OPENAI_API_KEY=

# JEV — TypeSafe AI's systemOne model (https://docs.typesafe.ai/api).
# JEV_API_KEY is what switches the app over to the real model — set it and
# src/lib/jev.ts calls https://api.typesafe.ai/v1/systemone directly.
# Leave it empty and the app falls back to the local keyword heuristic in
# src/lib/jev.ts, so the app is demoable without a live JEV key.
JEV_API_KEY=

# Optional overrides — defaults are the real systemOne endpoint and
# "jev-latest". Only set these if you're using a gateway (e.g. OpenRouter,
# Opper) in front of TypeSafe, or want to pin a specific Jev version.
JEV_API_URL=
JEV_MODEL=
